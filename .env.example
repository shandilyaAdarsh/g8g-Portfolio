# ==============================================================================
# G8G Media Next.js Production Environment Configuration Template
# ==============================================================================

# --- Frontend Deployment & SEO (Exposed to browser via NEXT_PUBLIC_) ---
# Canonical base URL used for sitemap, Open Graph, and canonical tag resolution.
NEXT_PUBLIC_SITE_URL="https://g8g.media"

# Optional Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# When omitted, analytics calls safely no-op without transmitting data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Enable verbose console logging of analytics events in development
NEXT_PUBLIC_ANALYTICS_DEBUG="false"

# --- Backend Server Configuration (Server-Side Only) ---
PORT=3000
NODE_ENV="production"

# --- Email Delivery Configuration (Server-Side Only) ---
CONTACT_EMAIL_TO="hello@g8g.media"
CONTACT_EMAIL_FROM="inquiries@g8g.media"

# Resend API Key (obtain from https://resend.com)
# When unconfigured, inquiries are safely queued with an honest status: 'accepted'
EMAIL_PROVIDER_API_KEY=""

# --- Inquiries Excel & Google Sheets Automation ---
# Google Sheets Web App Webhook URL (from Google Apps Script deployment)
GOOGLE_SHEETS_WEBHOOK_URL=""
# Optional custom local excel file path (defaults to data/inquiries.xlsx)
EXCEL_INQUIRIES_PATH=""

# --- Sanity CMS Configuration ---
# Project ID and dataset for remote Sanity studio integration.
# When omitted or set to 'placeholder', the app automatically falls back to verified local project registry.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_READ_TOKEN=""

# --- Mux Video Delivery Configuration ---
# Hosted adaptive video streaming credentials (server-side only, never exposed to client).
# When unconfigured, the app renders responsive art-directed media previews and fallback video players.
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
NEXT_PUBLIC_MUX_DEFAULT_PLAYBACK_ID=""
